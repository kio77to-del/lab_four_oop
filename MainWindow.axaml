<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:lab_four_oop.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="lab_four_oop.MainWindow"
        Title="Лабораторная работа 4 - Визуальный редактор"
        Width="1280"
        Height="820"
        Background="White">

    <Grid RowDefinitions="*,42"
          ColumnDefinitions="*,240">

        <Border Grid.Row="0"
                Grid.Column="0"
                Margin="12"
                Background="White"
                BorderBrush="#BFBFBF"
                BorderThickness="1">
            <local:DrawingArea Name="DrawArea"
                               Focusable="True"/>
        </Border>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,12,12,12"
                    Spacing="10">

            <TextBlock Text="Инструменты"
                       FontSize="20"
                       FontWeight="Bold"/>

            <Button Name="CircleButton" Content="Круг" Height="36"/>
            <Button Name="RectangleButton" Content="Прямоугольник" Height="36"/>
            <Button Name="SquareButton" Content="Квадрат" Height="36"/>
            <Button Name="EllipseButton" Content="Эллипс" Height="36"/>
            <Button Name="TriangleButton" Content="Треугольник" Height="36"/>

            <Separator Margin="0,6,0,6"/>

            <TextBlock Text="Цвет"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <ColorPicker Name="ShapeColorPicker"
                         IsAlphaEnabled="False"
                         IsAlphaVisible="False"
                         IsColorModelVisible="False"
                         IsHexInputVisible="True"/>

            <Button Name="ApplyColorButton"
                    Content="Применить цвет"
                    Height="36"/>

            <Separator Margin="0,6,0,6"/>

            <TextBlock Text="Действия"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <Button Name="DeleteButton"
                    Content="Удалить выделенные"
                    Height="36"/>

            <Button Name="ClearSelectionButton"
                    Content="Снять выделение"
                    Height="36"/>

            <Button Name="ClearButton"
                    Content="Очистить всё"
                    Height="36"/>

        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#CFCFCF"
                BorderThickness="1,1,0,0"
                Padding="12,0">
            <TextBlock Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Text="Статус: приложение запущено"/>
        </Border>
    </Grid>
</Window>