<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:lab_four_oop.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="750"
        x:Class="lab_four_oop.MainWindow"
        Title="Лабораторная работа 4 - Визуальный редактор"
        Width="1100"
        Height="750">

    <Grid RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="*,260">

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#DDDDDD"
                Padding="10">
            <TextBlock Text="Визуальный редактор фигур"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="10"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
            <local:DrawingArea Name="DrawArea"
                               Focusable="True"/>
        </Border>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    Spacing="10">

            <TextBlock Text="Инструменты"
                       FontSize="18"
                       FontWeight="Bold"/>

            <Button Name="CircleButton" Content="Круг"/>
            <Button Name="RectangleButton" Content="Прямоугольник"/>
            <Button Name="SquareButton" Content="Квадрат"/>
            <Button Name="EllipseButton" Content="Эллипс"/>
            <Button Name="TriangleButton" Content="Треугольник"/>

            <Separator/>

            <TextBlock Text="Выбор цвета"
                       FontSize="16"
                       FontWeight="Bold"/>

            <ColorPicker Name="ShapeColorPicker"
                         IsAlphaEnabled="False"
                         IsAlphaVisible="False"
                         IsColorModelVisible="False"
                         IsHexInputVisible="True"
                         MinWidth="180"/>

            <Button Name="ApplyColorButton" Content="Применить цвет"/>

            <Separator/>

            <Button Name="DeleteButton" Content="Удалить выделенные"/>
            <Button Name="ClearButton" Content="Очистить всё"/>

        </StackPanel>

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#DDDDDD"
                Padding="8">
            <TextBlock Name="StatusTextBlock"
                       Text="Статус: приложение запущено"/>
        </Border>

    </Grid>
</Window>